rules_version = '2';

// 安心企業研修Safy Firestoreセキュリティルール
// 設計書 Step5: 企業単位のデータ分離必須・監査ログ(quizAttempts/certificates)は
// Cloud Functions(Admin SDK)経由の書き込みのみ許可・管理者/受講者の権限分離。
//
// 権限分離の方式: Employeeドキュメント名を必ずFirebase Auth uidと一致させ(EmployeeService参照)、
// ルール内でそのドキュメントを読んでcompanyId所属・roleを検証する。
// Custom Claims未使用のため、Cloud Functionsによるclaims設定が完了していない現段階でも機能する。
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function employeeData(companyId) {
      return get(/databases/$(database)/documents/companies/$(companyId)/employees/$(request.auth.uid)).data;
    }

    function isCompanyMember(companyId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/companies/$(companyId)/employees/$(request.auth.uid));
    }

    function isAdmin(companyId) {
      return isCompanyMember(companyId) && employeeData(companyId).role == 'admin';
    }

    function isSelf(employeeId) {
      return isSignedIn() && request.auth.uid == employeeId;
    }

    // --- グローバルコンテンツ(全テナント共通・読み取り専用。管理はConsole/Admin SDK) ---
    match /industries/{industryId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /modules/{moduleId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /lessons/{lessonId} {
        allow read: if isSignedIn();
        allow write: if false;
      }

      match /quizQuestions/{questionId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    // 認定試験(Tier2/Tier3)の問題セット。管理はConsole/Admin SDKのみ。
    match /exams/{examId} {
      allow read: if isSignedIn();
      allow write: if false;

      match /questions/{questionId} {
        allow read: if isSignedIn();
        allow write: if false;
      }
    }

    match /examQuestions/{questionId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // --- 招待コード(Join前は所属会社が未確定のためトップレベル) ---
    match /inviteCodes/{code} {
      // 未参加の匿名ユーザーが自分のコードを個別解決できるよう get は許可するが、
      // 全社横断でコードを列挙されないよう list(コレクションクエリ)は禁止する。
      allow get: if isSignedIn();
      allow list: if false;
      // 発行・失効化は管理者のみ(companyIdはリソース内のフィールドで検証)
      allow create: if isAdmin(request.resource.data.companyId);
      allow update: if isAdmin(resource.data.companyId);
      allow delete: if false;
    }

    // --- マルチテナントデータ(companies/{companyId}配下) ---
    match /companies/{companyId} {
      allow read: if isCompanyMember(companyId);
      allow create: if isSignedIn(); // 会社プロファイル設定(管理者初回登録)
      allow update: if isAdmin(companyId);
      allow delete: if false;

      match /teams/{teamId} {
        allow read: if isCompanyMember(companyId);
        allow write: if isAdmin(companyId);
      }

      match /employees/{employeeId} {
        allow read: if isCompanyMember(companyId);
        // 招待コード参加・管理者登録は「自分自身のuidをドキュメントIDにして作成」のみ許可。
        // 自己登録経路(client)では role を常に 'member' 固定にし、admin昇格は
        // Cloud Functions(Admin SDK)経由でのみ行う想定とする。
        allow create: if isSelf(employeeId) &&
          request.resource.data.companyId == companyId &&
          request.resource.data.role == 'member';
        // 管理者は全フィールド更新可。本人更新は role/companyId の変更を禁止し、
        // 自己昇格や他社への付け替えを防ぐ。
        allow update: if isAdmin(companyId) ||
          (isSelf(employeeId) &&
           request.resource.data.role == resource.data.role &&
           request.resource.data.companyId == resource.data.companyId);
        allow delete: if isAdmin(companyId);
      }

      match /enrollments/{enrollmentId} {
        allow read: if isCompanyMember(companyId) &&
          (isAdmin(companyId) || resource.data.employeeId == request.auth.uid);
        allow create: if isCompanyMember(companyId) && request.resource.data.employeeId == request.auth.uid;
        allow update: if isCompanyMember(companyId) && resource.data.employeeId == request.auth.uid;
        allow delete: if false;
      }

      match /progressRecords/{recordId} {
        allow read: if isCompanyMember(companyId) &&
          (isAdmin(companyId) || resource.data.employeeId == request.auth.uid);
        allow create: if isCompanyMember(companyId) && request.resource.data.employeeId == request.auth.uid;
        allow update: if isCompanyMember(companyId) && resource.data.employeeId == request.auth.uid;
        allow delete: if false;
      }

      // Cloud Functions(recordTrainingProgress)経由でのみ記録される受講進捗ログ。
      match /trainingAttempts/{attemptId} {
        allow read: if isCompanyMember(companyId) &&
          (isAdmin(companyId) || resource.data.employeeId == request.auth.uid);
        allow write: if false;
      }

      // Cloud Functions(submitLiveExam)経由でのみ記録される認定試験の受験結果。
      match /examAttempts/{attemptId} {
        allow read: if isCompanyMember(companyId) &&
          (isAdmin(companyId) || resource.data.employeeId == request.auth.uid);
        allow write: if false;
      }

      // 監査証跡: 改ざん防止のためクライアントからの書き込みは一切禁止。
      // 発行・記録はCloud Functions(Admin SDK、ルールをバイパス)経由のみ。
      match /quizAttempts/{attemptId} {
        allow read: if isCompanyMember(companyId) &&
          (isAdmin(companyId) || resource.data.employeeId == request.auth.uid);
        allow write: if false;
      }

      match /certificates/{certificateId} {
        allow read: if isCompanyMember(companyId) &&
          (isAdmin(companyId) || resource.data.employeeId == request.auth.uid);
        allow write: if false;
      }

      match /subscriptions/{subscriptionId} {
        allow read: if isCompanyMember(companyId);
        // 契約の作成・変更は管理者のみ(個人利用は自分専用の会社の管理者として扱われる)
        allow write: if isAdmin(companyId);
      }

      match /reminders/{reminderId} {
        allow read: if isCompanyMember(companyId);
        allow create: if isAdmin(companyId);
        allow update: if false;
        allow delete: if false;
      }

      // オリジナルコンテンツ(プレミアムプラン)。契約段階のサーバー側再検証は
      // generateOriginalContent Cloud Functionで行うため、ここでは他社データからの
      // 分離と「管理者のみ書き込み・全社員が閲覧可」という権限分離のみを担保する。
      match /customModules/{moduleId} {
        allow read: if isCompanyMember(companyId);
        allow write: if isAdmin(companyId);

        match /lessons/{lessonId} {
          allow read: if isCompanyMember(companyId);
          allow write: if isAdmin(companyId);
        }

        match /quizQuestions/{questionId} {
          allow read: if isCompanyMember(companyId);
          allow write: if isAdmin(companyId);
        }
      }

      match /moduleExtensions/{moduleId} {
        allow read: if isCompanyMember(companyId);
        allow write: if isAdmin(companyId);

        match /lessons/{lessonId} {
          allow read: if isCompanyMember(companyId);
          allow write: if isAdmin(companyId);
        }

        match /quizQuestions/{questionId} {
          allow read: if isCompanyMember(companyId);
          allow write: if isAdmin(companyId);
        }
      }

      // --- Phase 2b: 従業員診断とレベル判定 ---
      match /employeeDiagnostics/{diagnosticId} {
        allow read: if isCompanyMember(companyId) &&
          (isAdmin(companyId) || resource.data.employeeId == request.auth.uid);
        // Cloud Functions経由でのみ書き込み可(クライアント書き込み禁止)
        allow write: if false;
      }

      // --- Phase 2b: 学習パス(パーソナライゼーション) ---
      match /learningPaths/{pathId} {
        allow read: if isCompanyMember(companyId);
        allow write: if false; // Cloud Functions経由でのみ管理
      }

      // --- Phase 2b: Q&Aフォーラム ---
      match /qaForum/{questionId} {
        // 全従業員が質問一覧を読み取り可
        allow read: if isCompanyMember(companyId);
        // 質問投稿はCloud Functions経由(submitQuestion)
        allow create: if false;
        allow update: if false;
        allow delete: if isAdmin(companyId);

        // 質問に対する回答
        match /answers/{answerId} {
          allow read: if isCompanyMember(companyId);
          // 回答投稿はCloud Functions経由(submitAnswer)
          allow create: if false;
          allow update: if isAdmin(companyId) || resource.data.authorId == request.auth.uid;
          allow delete: if isAdmin(companyId) || resource.data.authorId == request.auth.uid;
        }
      }

      // --- ユーザーフィードバック(NPS・感情分析) ---
      match /userFeedback/{feedbackId} {
        allow read: if isAdmin(companyId);
        allow create: if isCompanyMember(companyId);
        allow update: if false;
        allow delete: if isAdmin(companyId);
      }
    }
  }
}
